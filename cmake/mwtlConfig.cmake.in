@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/Dependencies.cmake")
mwtl_resolve_dependencies()
include("${CMAKE_CURRENT_LIST_DIR}/mwtlTargets.cmake")
set_property(TARGET mwtl::mwtl APPEND PROPERTY
    INTERFACE_LINK_LIBRARIES WTL::WTL WIL::WIL)

if(TARGET mwtl::d2d)
    set(mwtl_d2d_FOUND TRUE)
endif()
if(TARGET mwtl::d3d)
    set(mwtl_d3d_FOUND TRUE)
endif()
if(TARGET mwtl::imaging)
    set(mwtl_imaging_FOUND TRUE)
endif()
if(TARGET mwtl::printing)
    set(mwtl_printing_FOUND TRUE)
endif()
if(TARGET mwtl::scintilla)
    set(mwtl_scintilla_FOUND TRUE)
    set(MWTL_SCINTILLA_RUNTIME "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/Scintilla.dll")
    function(mwtl_deploy_scintilla target)
        if(NOT TARGET "${target}")
            message(FATAL_ERROR "mwtl_deploy_scintilla target does not exist: ${target}")
        endif()
        add_custom_command(TARGET "${target}" POST_BUILD
            COMMAND "${CMAKE_COMMAND}" -E copy_if_different
                "${MWTL_SCINTILLA_RUNTIME}" "$<TARGET_FILE_DIR:${target}>/Scintilla.dll")
    endfunction()
endif()
if(TARGET mwtl::webview2)
    set(mwtl_webview2_FOUND TRUE)
    if(NOT TARGET mwtl::webview2_loader)
        add_library(mwtl::webview2_loader STATIC IMPORTED)
        set_target_properties(mwtl::webview2_loader PROPERTIES
            IMPORTED_LOCATION
                "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/WebView2LoaderStatic.lib")
    endif()
    set_property(TARGET mwtl::webview2 APPEND PROPERTY
        INTERFACE_LINK_LIBRARIES mwtl::webview2_loader runtimeobject)
endif()

check_required_components(mwtl)
