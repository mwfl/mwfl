@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/Dependencies.cmake")
mwfl_resolve_dependencies()
include("${CMAKE_CURRENT_LIST_DIR}/mwflTargets.cmake")
set_property(TARGET mwfl::ui APPEND PROPERTY
    INTERFACE_LINK_LIBRARIES WIL::WIL)

if(TARGET mwfl::d2d)
    set(mwfl_d2d_FOUND TRUE)
endif()
if(TARGET mwfl::d3d)
    set(mwfl_d3d_FOUND TRUE)
endif()
if(TARGET mwfl::imaging)
    set(mwfl_imaging_FOUND TRUE)
endif()
if(TARGET mwfl::printing)
    set(mwfl_printing_FOUND TRUE)
endif()
if(TARGET mwfl::ole)
    set(mwfl_ole_FOUND TRUE)
endif()
if(TARGET mwfl::shell)
    set(mwfl_shell_FOUND TRUE)
endif()
if(TARGET mwfl::ribbon)
    set(mwfl_ribbon_FOUND TRUE)
endif()
if(TARGET mwfl::mdi)
    set(mwfl_mdi_FOUND TRUE)
endif()
if(TARGET mwfl::graphics)
    set(mwfl_graphics_FOUND TRUE)
endif()
if(TARGET mwfl::scintilla)
    set(mwfl_scintilla_FOUND TRUE)
    set(MWFL_SCINTILLA_RUNTIME "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/Scintilla.dll")
    function(mwfl_deploy_scintilla target)
        if(NOT TARGET "${target}")
            message(FATAL_ERROR "mwfl_deploy_scintilla target does not exist: ${target}")
        endif()
        add_custom_command(TARGET "${target}" POST_BUILD
            COMMAND "${CMAKE_COMMAND}" -E copy_if_different
                "${MWFL_SCINTILLA_RUNTIME}" "$<TARGET_FILE_DIR:${target}>/Scintilla.dll")
    endfunction()
endif()
if(TARGET mwfl::webview2)
    set(mwfl_webview2_FOUND TRUE)
    if(NOT TARGET mwfl::webview2_loader)
        add_library(mwfl::webview2_loader STATIC IMPORTED)
        set_target_properties(mwfl::webview2_loader PROPERTIES
            IMPORTED_LOCATION
                "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/WebView2LoaderStatic.lib")
    endif()
    set_property(TARGET mwfl::webview2 APPEND PROPERTY
        INTERFACE_LINK_LIBRARIES mwfl::webview2_loader runtimeobject)
endif()

check_required_components(mwfl)
