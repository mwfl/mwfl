root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h}]
indent_style = space
indent_size = 4

[*.{cmake,json,yml,yaml,md,html,css,js}]
indent_style = space
indent_size = 2

[*.ps1]
indent_style = space
indent_size = 4

[CMakeLists.txt]
indent_style = space
indent_size = 4
