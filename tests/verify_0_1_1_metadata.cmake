file(STRINGS "${PROJECT_ROOT}/docs/public-api-baseline-0.1.txt" baseline_headers)
foreach(header IN LISTS baseline_headers)
    if(header STREQUAL "" OR header MATCHES "^#")
        continue()
    endif()
    if(NOT EXISTS "${PROJECT_ROOT}/include/mwfl/${header}")
        message(FATAL_ERROR "Stable v0.1 public header is missing: ${header}")
    endif()
endforeach()

file(READ "${PROJECT_ROOT}/docs/downstream-consumers.json" downstream)
string(JSON schema GET "${downstream}" schema_version)
if(NOT schema EQUAL 1)
    message(FATAL_ERROR "Unsupported downstream consumer schema: ${schema}")
endif()
string(JSON count LENGTH "${downstream}" consumers)
if(NOT count EQUAL 8)
    message(FATAL_ERROR "Official downstream catalog must contain eight applications; found ${count}")
endif()
math(EXPR last "${count} - 1")
set(names "")
foreach(index RANGE 0 ${last})
    foreach(field IN ITEMS name repository preset local_option role)
        string(JSON value GET "${downstream}" consumers ${index} ${field})
        if(value STREQUAL "")
            message(FATAL_ERROR "Downstream consumer ${index} has an empty ${field}")
        endif()
    endforeach()
    string(JSON name GET "${downstream}" consumers ${index} name)
    list(FIND names "${name}" duplicate)
    if(NOT duplicate EQUAL -1)
        message(FATAL_ERROR "Duplicate downstream consumer: ${name}")
    endif()
    list(APPEND names "${name}")
endforeach()

file(READ "${PROJECT_ROOT}/.github/workflows/downstream.yml" workflow)
foreach(name IN LISTS names)
    if(NOT workflow MATCHES "${name}")
        message(FATAL_ERROR "Downstream workflow does not cover ${name}")
    endif()
endforeach()

file(READ "${PROJECT_ROOT}/docs/stability.md" stability)
foreach(marker IN ITEMS "source compatibility" "Deprecations remain" "ABI compatibility is not promised")
    if(NOT stability MATCHES "${marker}")
        message(FATAL_ERROR "Stability policy is missing: ${marker}")
    endif()
endforeach()

file(READ "${PROJECT_ROOT}/scripts/verify.ps1" verification_script)
if(verification_script MATCHES "Release ARM64 has no repository preset")
    message(FATAL_ERROR "Full verification still skips the ARM64 Release preset")
endif()
foreach(preset IN ITEMS vs2022-arm64-release vs2026-arm64-release)
    file(READ "${PROJECT_ROOT}/CMakePresets.json" presets)
    if(NOT presets MATCHES "${preset}")
        message(FATAL_ERROR "Maintained ARM64 Release preset is missing: ${preset}")
    endif()
endforeach()

file(READ "${PROJECT_ROOT}/.github/workflows/ci.yml" ci)
foreach(job IN ITEMS vs2022-compatibility static-analysis address-sanitizer coverage reliability-repeat arm64)
    if(NOT ci MATCHES "${job}:")
        message(FATAL_ERROR "Required 0.1.1 CI job is missing: ${job}")
    endif()
endforeach()

file(READ "${PROJECT_ROOT}/docs/parity.json" parity)
string(JSON release_version GET "${parity}" active_release version)
string(JSON release_status GET "${parity}" active_release status)
string(JSON release_commit GET "${parity}" active_release commit)
string(JSON release_tag GET "${parity}" active_release tag)
if(NOT release_version STREQUAL "0.1.1" OR
   NOT release_status STREQUAL "complete" OR
   NOT release_commit STREQUAL "c40624326163bb59f4a1d5c74842e51ae13ffc78" OR
   NOT release_tag STREQUAL "v0.1.1")
    message(FATAL_ERROR "0.1.1 release metadata is not closed on the published commit and tag")
endif()

file(READ "${PROJECT_ROOT}/docs/milestones/0.1.1.md" milestone)
if(milestone MATCHES "- \\[ \\]")
    message(FATAL_ERROR "Completed 0.1.1 milestone has unchecked acceptance items")
endif()

file(READ "${PROJECT_ROOT}/docs/releases/unreleased.md" unreleased)
if(unreleased MATCHES "0\\.1\\.1 \\(unreleased\\)" OR
   NOT unreleased MATCHES "v0\\.1\\.1\\.md")
    message(FATAL_ERROR "Unreleased notes do not hand off cleanly from v0.1.1")
endif()

file(READ "${PROJECT_ROOT}/docs/releases/0.1.1-candidate.md" evidence)
foreach(marker IN ITEMS
        "32612122580" "32612122581" "32613130579"
        "c40624326163bb59f4a1d5c74842e51ae13ffc78"
        "6b4106f1d0f8be74c31a355ebb8d5a2a29b502715fd315afd80284989fe63b9f"
        "dad7654f2d67054521ee3b391ebc18eb3ad8fbb0f9c380f6b5f9f65ffbcd7500"
        "gh attestation verify" "All 0.1.1 acceptance and publication gates are complete")
    if(NOT evidence MATCHES "${marker}")
        message(FATAL_ERROR "0.1.1 release evidence is missing: ${marker}")
    endif()
endforeach()
