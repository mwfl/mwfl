{
  "schema_version": 1,
  "library": "mwtl",
  "language": "C++20",
  "platforms": ["Windows x64", "Windows ARM64"],
  "capabilities": [
    {
      "id": "application-window",
      "intent": ["create a Windows app", "open a native window"],
      "symbols": ["mwtl::WindowBase", "mwtl::RunApplication"],
      "headers": ["mwtl/window.h", "mwtl/application.h"],
      "example": "examples/hello/main.cpp",
      "recipe": "docs/recipes/create-window.md"
    },
    {
      "id": "native-form",
      "intent": ["build a form", "validate input", "bind controls"],
      "symbols": ["mwtl::ControlHost", "mwtl::ValueBinding", "mwtl::ValidationResult"],
      "headers": ["mwtl/control_host.h", "mwtl/binding.h"],
      "example": "examples/form_binding/main.cpp",
      "constraints": ["controls, model values, and bindings need compatible lifetimes"]
    },
    {
      "id": "responsive-layout",
      "intent": ["responsive layout", "row", "column", "overlay"],
      "symbols": ["mwtl::Row", "mwtl::Column", "mwtl::Overlay", "mwtl::Stretch"],
      "headers": ["mwtl/layout.h"],
      "example": "examples/layout_gallery/main.cpp",
      "constraints": ["layout uses DIPs and references already-created HWNDs"]
    },
    {
      "id": "commands",
      "intent": ["menu", "toolbar", "keyboard shortcut", "shared action"],
      "symbols": ["mwtl::Command", "mwtl::CommandSet", "mwtl::Toolbar", "mwtl::Menu"],
      "headers": ["mwtl/command.h", "mwtl/command_controls.h", "mwtl/desktop.h"],
      "example": "examples/notepad/main.cpp",
      "tests": ["mwtl.command", "mwtl.modern_api", "mwtl.desktop"],
      "constraints": ["Command is the source for text enabled checked visible image and shortcut state", "a toolbar borrows its ImageList", "rebuild a menu to show a command after removing it"]
    },
    {
      "id": "document-state",
      "intent": ["track an open document", "prompt for unsaved changes", "coordinate save before close"],
      "symbols": ["mwtl::DocumentState", "mwtl::DocumentTransition", "mwtl::UnsavedChangesChoice"],
      "headers": ["mwtl/document.h"],
      "example": "examples/document_state/main.cpp",
      "tests": ["mwtl.document"],
      "constraints": ["applications own contents and perform file I/O", "record opened or saved state only after I/O succeeds", "the model belongs to the document coordination thread"]
    },
    {
      "id": "tab-workspace-state",
      "intent": ["track application tabs", "keep stable tab identity", "synchronize a native tab control"],
      "symbols": ["mwtl::TabWorkspaceModel", "mwtl::TabId", "mwtl::TabControl"],
      "headers": ["mwtl/tab_workspace.h", "mwtl/navigation_controls.h"],
      "example": "examples/common_controls/main.cpp",
      "tests": ["mwtl.tab_workspace", "mwtl.modern_api"],
      "constraints": ["zero is not a valid TabId", "the model does not own documents or page HWNDs", "returned views expire on mutation", "use GetSelectedTabId to read native selection"]
    },
    {
      "id": "split-pane-composition",
      "intent": ["compose two resizable panes", "enforce pane minimum sizes", "support keyboard splitter movement"],
      "symbols": ["mwtl::Splitter", "mwtl::SplitterModel", "mwtl::SplitterNotification"],
      "headers": ["mwtl/splitter.h"],
      "example": "examples/common_controls/main.cpp",
      "tests": ["mwtl.splitter", "mwtl.splitter_native"],
      "constraints": ["positions and constraints are DIPs", "the splitter owns its container HWND and borrows direct-child pane HWNDs", "all native operations belong to the creating UI thread"]
    },
    {
      "id": "stable-navigation-data",
      "intent": ["tree with stable item identity", "multi-select report view", "virtual ListView", "sort or label-edit native rows"],
      "symbols": ["mwtl::TreeItemId", "mwtl::TreeView", "mwtl::ListItemId", "mwtl::ListView", "mwtl::VirtualListModel"],
      "headers": ["mwtl/navigation_controls.h"],
      "example": "examples/common_controls/main.cpp",
      "tests": ["mwtl.navigation_model", "mwtl.navigation_native", "mwtl.modern_api", "mwtl.package_consumer"],
      "constraints": ["IDs are unique stable and nonzero", "ListView is multi-select unless LVS_SINGLESEL is requested", "virtual models are shared and authoritative", "route owner-data WM_NOTIFY through HandleNotification and check TakeVirtualException", "never store application object pointers in native item data", "all operations stay on the creating UI thread"]
    },
    {
      "id": "typed-selections",
      "intent": ["associate typed values with native choices", "select by application value", "avoid unsafe native item pointers"],
      "symbols": ["mwtl::SelectionAdapter", "mwtl::SelectionEntry"],
      "headers": ["mwtl/selection.h", "mwtl/controls.h", "mwtl/navigation_controls.h"],
      "example": "tests/modern_api_test.cpp",
      "tests": ["mwtl.selection", "mwtl.modern_api", "mwtl.package_consumer"],
      "constraints": ["the adapter owns labels and values while the control owns only native labels", "the adapter must be the exclusive item mutator", "all adapter and control operations stay on the control UI thread"]
    },
    {
      "id": "unicode-text-file",
      "intent": ["open a text document", "save a text document safely", "detect an external file change"],
      "symbols": ["mwtl::ReadTextFile", "mwtl::WriteTextFileAtomic", "mwtl::TextFile", "mwtl::FileStamp"],
      "headers": ["mwtl/text_file.h"],
      "example": "examples/notepad/main.cpp",
      "tests": ["mwtl.text_file"],
      "constraints": ["malformed Unicode is rejected", "save uses a flushed sibling temporary and atomic replacement", "pass the read FileStamp to detect stale editor content"]
    },
    {
      "id": "text-search",
      "intent": ["find text", "replace text", "implement an editor find dialog"],
      "symbols": ["mwtl::FindTextMatch", "mwtl::TextMatchesAt", "mwtl::ReplaceAllText"],
      "headers": ["mwtl/text_search.h"],
      "example": "examples/notepad/main.cpp",
      "tests": ["mwtl.text_search"],
      "constraints": ["empty queries never match", "whole-word treats letters, digits, and underscore as word characters", "replace-all advances after inserted text"]
    },
    {
      "id": "text-history",
      "intent": ["undo text edits", "redo text edits", "track whether undo returned to the saved text"],
      "symbols": ["mwtl::TextHistory"],
      "headers": ["mwtl/text_history.h"],
      "example": "examples/notepad/main.cpp",
      "tests": ["mwtl.text_history"],
      "constraints": ["history stores bounded snapshots", "new edits truncate the redo branch", "returned views expire on mutation"]
    },
    {
      "id": "recent-files",
      "intent": ["show recent files", "persist recent files", "restore editor settings"],
      "symbols": ["mwtl::RecentFileList", "mwtl::LoadRecentFilesFromRegistry", "mwtl::SaveRecentFilesToRegistry"],
      "headers": ["mwtl/recent_files.h"],
      "example": "examples/notepad/main.cpp",
      "tests": ["mwtl.recent_files"],
      "constraints": ["root registry handles are borrowed", "schema version is validated", "paths are deduplicated with Windows case-insensitive comparison"]
    },
    {
      "id": "single-instance",
      "intent": ["allow only one application instance", "forward a file to the existing window", "activate an existing application"],
      "symbols": ["mwtl::SingleInstance", "mwtl::ActivationResult", "mwtl::ActivationStatus"],
      "headers": ["mwtl/single_instance.h"],
      "example": "examples/notepad/main.cpp",
      "tests": ["mwtl.single_instance"],
      "constraints": ["register only the primary top-level window", "activation payloads are bounded copied UTF-16", "same-user UIPI access denial is reported"]
    },
    {
      "id": "sdi-notepad-reference",
      "intent": ["build a text editor", "build an SDI document application", "test a real native application", "package a native executable"],
      "symbols": ["mwtl::DocumentState", "mwtl::CommandSet", "mwtl::StatusBar", "mwtl::ReadTextFile", "mwtl::SingleInstance"],
      "headers": ["mwtl/document.h", "mwtl/command.h", "mwtl/command_controls.h", "mwtl/text_file.h", "mwtl/single_instance.h"],
      "example": "examples/notepad/main.cpp",
      "tests": ["mwtl.notepad_gui", "mwtl.text_file", "mwtl.document", "mwtl.package_consumer"],
      "constraints": ["start from templates/basic-app", "mark document state only after successful I/O", "optional preference failures never discard document content", "the UI stays on its creating thread"]
    },
    {
      "id": "background-ui-update",
      "intent": ["background worker", "update UI from thread", "notify window"],
      "symbols": ["mwtl::WindowWakeup"],
      "headers": ["mwtl/wakeup.h"],
      "example": "examples/wakeup/main.cpp",
      "constraints": ["workers never access UI wrappers", "TryWake false is normal during shutdown"]
    },
    {
      "id": "desktop-integration",
      "intent": ["open file", "save file", "choose folder", "clipboard", "file drop", "window placement"],
      "symbols": ["mwtl::FileDialogOptions", "mwtl::SavedWindowPlacement"],
      "headers": ["mwtl/desktop.h"],
      "example": "examples/desktop_integration/main.cpp"
    },
    {
      "id": "custom-dialog",
      "intent": ["custom dialog", "modal form", "modeless window", "resizable dialog"],
      "symbols": ["mwtl::Dialog", "mwtl::DialogOptions", "mwtl::DialogCallbacks", "mwtl::DialogResult"],
      "headers": ["mwtl/dialog.h"],
      "example": "examples/desktop_integration/main.cpp",
      "recipe": "docs/recipes/custom-dialog.md",
      "tests": ["mwtl.dialog_native"],
      "constraints": ["the owner HWND is borrowed", "the wrapper owns a modeless HWND", "callbacks and child controls stay on the creating UI thread", "cross-thread close requests require the owner thread to keep pumping messages", "callback exceptions are captured"]
    },
    {
      "id": "tray-application",
      "intent": ["tray icon", "notification area", "background utility", "balloon notification", "Explorer restart"],
      "symbols": ["mwtl::TrayIcon", "mwtl::TrayIconOptions", "mwtl::TrayIconEvent", "mwtl::TrayNotification"],
      "headers": ["mwtl/tray_icon.h"],
      "example": "examples/hot_corners/main.cpp",
      "recipe": "docs/recipes/tray-icon.md",
      "tests": ["mwtl.tray_icon_native", "mwtl.hot_corners_self_test"],
      "constraints": ["use a stable application GUID", "the owner HWND and HICON are borrowed", "mutations and destruction stay on the creating UI thread", "recreate after TaskbarCreated", "dispatch menu choices through CommandSet"]
    },
    {
      "id": "appearance-accessibility",
      "intent": ["dark mode", "mica", "high contrast", "accessible name", "DPI"],
      "symbols": ["mwtl::AppearanceOptions", "mwtl::ApplyWindowAppearance", "mwtl::SetAccessibleName"],
      "headers": ["mwtl/appearance.h", "mwtl/dpi.h"],
      "example": "examples/appearance/main.cpp",
      "constraints": ["appearance is best effort", "High Contrast takes precedence"]
    },
    {
      "id": "property-sheet-settings",
      "intent": ["property sheet", "settings pages", "Apply OK Cancel", "modeless settings"],
      "symbols": ["mwtl::PropertyPage", "mwtl::PropertySheetModel", "mwtl::PropertySheetDialog", "mwtl::PropertySheetResult"],
      "headers": ["mwtl/property_sheet.h"],
      "example": "examples/property_sheet/main.cpp",
      "recipe": "docs/recipes/property-page.md",
      "tests": ["mwtl.property_sheet_model", "mwtl.property_sheet_native"],
      "constraints": ["page IDs are stable and nonzero", "page HWNDs are borrowed and lazily created", "modeless operations stay on the creating UI thread", "callback exceptions are captured in the result"]
    },
    {
      "id": "task-dialog",
      "intent": ["task dialog", "confirmation dialog", "progress dialog", "radio choice", "verification checkbox"],
      "symbols": ["mwtl::TaskDialogOptions", "mwtl::TaskDialogController", "mwtl::TaskDialogEvent", "mwtl::TaskDialogResult", "mwtl::ShowTaskDialog"],
      "headers": ["mwtl/control_resources.h"],
      "example": "examples/common_controls/main.cpp",
      "tests": ["mwtl.task_dialog"],
      "constraints": ["the owner HWND is borrowed", "the controller is callback-scoped and UI-thread-only", "keep_open only changes button-close handling", "callback exceptions are captured", "check IsTaskDialogAvailable when availability matters"]
    },
    {
      "id": "control-resources",
      "intent": ["tooltip", "balloon tooltip", "image list", "context menu", "popup command"],
      "symbols": ["mwtl::Tooltip", "mwtl::TooltipOptions", "mwtl::ImageList", "mwtl::Menu", "mwtl::PopupMenuResult"],
      "headers": ["mwtl/control_resources.h", "mwtl/desktop.h"],
      "example": "examples/common_controls/main.cpp",
      "tests": ["mwtl.control_resources_native", "mwtl.modern_api", "mwtl.desktop"],
      "constraints": ["ImageList owns its HIMAGELIST and toolbar borrowing requires it to outlive the toolbar", "Tooltip owns text and its HWND but borrows owner and tools", "tooltip text does not replace an accessible name", "command ID zero is invalid for popup selection", "invalid menu or owner is failed while zero after valid tracking is cancelled because TrackPopupMenuEx has no extended error"]
    }
  ]
}
