{
  "schema_version": 1,
  "default": ["fast"],
  "paths": [
    {"pattern":"docs/capabilities.json","validation":["docs","metadata"]},
    {"pattern":"scripts/generate-site-components.ps1","validation":["docs","fast"]},
    {"pattern":"site/components/catalog.html","validation":["docs","metadata"]},
    {"pattern":"include/mwfl/docking_workspace.h","validation":["fast","unit","native","gui","lifecycle","package","full"]},
    {"pattern":"include/mwfl/docking_*.h","validation":["fast","unit","native","gui","lifecycle","package","full"]},
    {"pattern":"src/docking_*.cpp","validation":["fast","unit","native","gui","lifecycle","full"]},
    {"pattern":"examples/docking_workspace/**","validation":["fast","gui","metadata","full"]},
    {"pattern":"include/mwfl/document_workspace.h","validation":["fast","unit","gui","lifecycle","package","full"]},
    {"pattern":"include/mwfl/document_coordination.h","validation":["fast","unit","gui","lifecycle","package","full"]},
    {"pattern":"include/mwfl/document_tabs.h","validation":["fast","unit","native","gui","lifecycle","package","full"]},
    {"pattern":"include/mwfl/document_session.h","validation":["fast","unit","gui","package","full"]},
    {"pattern":"examples/document_workspace/**","validation":["fast","gui","metadata","full"]},
    {"pattern":"include/mwfl/**","validation":["fast","unit","lifecycle","package","full"]},
    {"pattern":"src/layout.cpp","validation":["fast","unit","layout","full"]},
    {"pattern":"src/message_pump.cpp","validation":["fast","lifecycle","gui","full"]},
    {"pattern":"src/application.cpp","validation":["fast","lifecycle","package","full"]},
    {"pattern":"src/**","validation":["fast","unit"]},
    {"pattern":"cmake/**","validation":["package","full"]},
    {"pattern":"CMakeLists.txt","validation":["package","full"]},
    {"pattern":"CMakePresets.json","validation":["docs","full"]},
    {"pattern":"tests/**","validation":["fast","full"]},
    {"pattern":"examples/**","validation":["fast","gui","metadata"]},
    {"pattern":"templates/**","validation":["package","docs"]},
    {"pattern":"docs/**","validation":["docs"]},
    {"pattern":"site/**","validation":["docs"]},
    {"pattern":".github/**","validation":["docs"]},
    {"pattern":"scripts/**","validation":["docs","fast"]},
    {"pattern":"agent-evals/**","validation":["docs","fast"]},
    {"pattern":"docs/api-index.json","validation":["docs","metadata"]},
    {"pattern":".vsconfig","validation":["docs"]}
  ]
}
